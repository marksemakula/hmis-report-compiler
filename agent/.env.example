# JRRH extraction agent — copy to .env and complete.
# This file holds a database credential: keep it on this machine only, and do
# not commit .env to git (.gitignore already excludes it).

COMPILER_URL=https://hmis-report-compiler.vercel.app

# Must match AGENT_KEY in the Vercel project settings.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
AGENT_KEY=

CM_SERVER=172.20.0.230
CM_DATABASE=ClinicMasterMOH

# A READ-ONLY SQL login. Do not use an account with write rights.
CM_USER=
CM_PASSWORD=

POLL_SECONDS=20
